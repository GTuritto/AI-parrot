# ==============================================
# Required API Keys
# ==============================================

# Required: Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==============================================
# Optional but Recommended
# ==============================================

# For GPT-4 script refinement (falls back to Claude Sonnet if not available)
# OPENAI_API_KEY=your_openai_api_key_here

# For high-quality text-to-speech (ElevenLabs)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# For News API integration (falls back to RSS feeds if not available)
# NEWS_API_KEY=your_news_api_key_here

# ==============================================
# Advanced Configuration
# ==============================================
# Google Cloud TTS (alternative to ElevenLabs)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-file.json

# Debug mode (set to '1' to enable verbose logging)
# DEBUG=0
